{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/jobs/rental-reminders", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/offer", "destination": "/offer.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/manager", "destination": "/manager.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ]
}
