# Never commit the real values. Copy this file to server/.env on the server only.
NODE_ENV=production
PORT=3000

# Created through @BotFather. Rotate it if it was ever placed in frontend code.
TELEGRAM_BOT_TOKEN=replace_with_new_token
# Needed after Vercel deployment to verify Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_value

# Telegram numeric user IDs allowed to approve, reject and confirm payments.
# Multiple IDs are separated by commas.
RENTOP_ADMIN_USER_IDS=123456789
# Private group or channel where the bot sends applications. It usually starts with -100.
RENTOP_ADMIN_CHAT_ID=-1001234567890

# Private Supabase server credentials. Never use the anon/publishable key here.
SUPABASE_URL=https://your-project.supabase.co
# Prefer the current secret key (sb_secret_...). Legacy service_role is supported only for existing projects.
SUPABASE_SECRET_KEY=replace_with_secret_key
# SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_key_if_you_do_not_have_a_secret_key

# These values are sent to a client only after the manager approves the documents.
MBANK_PAYMENT_DETAILS=Укажите реквизиты MBANK
SIMBANK_PAYMENT_DETAILS=Укажите реквизиты SIMBANK
# Optional local path to your MBANK QR image. The file stays outside Git.
MBANK_QR_IMAGE_PATH=./assets/mbank-qr.jpg
# On Vercel use a public HTTPS address instead of a local file path.
MBANK_QR_IMAGE_URL=https://rentop.com.kg/assets/brand/mbank-qr.jpg
# Optional contact shown to a client who asks specifically about an ARCHA POINT locker.
ARCHA_POINT_SUPPORT_CONTACT=

# Public address used by the website to create a booking and by Telegram deep links.
PUBLIC_APP_URL=https://rentop.com.kg
BACKEND_PUBLIC_URL=https://api.rentop.com.kg

# Temporary weekend mode: code is delivered in the verified Telegram chat.
# Switch to nikita as soon as Nikita KG enables the sender ID and API.
OTP_PROVIDER=telegram

# Nikita.kg XML SMS API. Keep these values only in server/.env and Vercel Project
# Environment Variables. Do not put them in browser JavaScript or commit them to Git.
NIKITA_SMS_ENDPOINT=https://smspro.nikita.kg/api/message
NIKITA_SMS_LOGIN=replace_with_nikita_login
NIKITA_SMS_PASSWORD=replace_with_nikita_password
# Must be a sender name approved by Nikita.kg, for example SMSPRO.KG or Rentop.
NIKITA_SMS_SENDER=SMSPRO.KG
# Used only by `npm run sms:test`; the API's test flag means no actual SMS is sent or charged.
NIKITA_SMS_TEST_PHONE=+996555123456

# Preferred variable names for the working Nikita configuration. The legacy
# NIKITA_SMS_* names above remain supported for backward compatibility.
# NIKITA_LOGIN=replace_with_nikita_login
# NIKITA_PASSWORD=replace_with_nikita_password
# NIKITA_SENDER_ID=SMSPRO.KG

# Long server-only random value used to HMAC OTP codes. This is not an SMS password.
OFFER_OTP_HMAC_SECRET=replace_with_a_long_random_value
OFFER_VERSION=draft-2026-09-25
# Set this only after the offer has received legal review and is published at a stable URL.
OFFER_URL=replace_with_published_offer_url
