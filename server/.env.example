# Never commit the real values. Copy this file to server/.env on the server only.
NODE_ENV=production
PORT=3000

# Created through @BotFather. Rotate it if it was ever placed in frontend code.
TELEGRAM_BOT_TOKEN=replace_with_new_token

# Telegram numeric user IDs allowed to approve, reject and confirm payments.
# Multiple IDs are separated by commas.
RENTOP_ADMIN_USER_IDS=123456789
# Private group or channel where the bot sends applications. It usually starts with -100.
RENTOP_ADMIN_CHAT_ID=-1001234567890

# Private Supabase server credentials. Never use the anon key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# These values are sent to a client only after the manager approves the documents.
MBANK_PAYMENT_DETAILS=Укажите реквизиты MBANK
SYNBANK_PAYMENT_DETAILS=Укажите реквизиты Синьбанк

# Public address used by the website to create a booking and by Telegram deep links.
PUBLIC_APP_URL=https://rentop.com.kg
BACKEND_PUBLIC_URL=https://api.rentop.com.kg
